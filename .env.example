# City of Warsaw API token (free, from dane.um.warszawa.pl)
WARSAW_API_TOKEN=

# Poller
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=vehicle-positions
POLL_INTERVAL_SECONDS=10

# Airflow runs as the same user as Spark (185), so both can write to the lake
AIRFLOW_UID=185

# Phone alerts: pick a long random topic name and subscribe to it in the ntfy app
NTFY_TOPIC=

# Optional: publishing data for the online dashboard
DASHBOARD_DATA_REPO=
DASHBOARD_DATA_TOKEN=